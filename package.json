{
  "name": "nomad-city-friends",
  "version": "0.5.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14 <25"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node tools/dev.mjs",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "start": "node apps/server/src/index.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:mobile": "playwright test --config playwright.mobile.config.ts",
    "check": "tsc --noEmit",
    "music:import": "node tools/import-music.ts",
    "music:check": "node tools/import-music.ts --check",
    "voices:acquire": "node tools/acquire-role-voices.mjs",
    "voices:check": "node tools/check-voices.ts",
    "release:prepare": "node tools/release.ts",
    "release:check": "node tools/check-release.ts",
    "backup": "node tools/backup.ts",
    "package:deploy": "node tools/package-deploy.ts",
    "package:windows": "node tools/package-windows.ts",
    "assets:catalog": "node tools/catalog.ts",
    "assets:check": "node tools/verify-assets.ts",
    "assets:restore": "node tools/restore-assets.ts",
    "public:audit": "node tools/check-public-repo.ts",
    "browsers:prepare": "node tools/prepare-browsers.ts",
    "format": "prettier --write apps packages tests tools/*.ts tools/*.mjs *.json *.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "vitest": "^3.2.4"
  }
}
